<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ResellerMart - Best Reseller Platform</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .navbar {
            background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
            padding: 1rem 2rem; box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            position: fixed; width: 100%; top: 0; z-index: 1000;
        }
        .nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .logo h2 { color: #667eea; font-size: 1.8rem; }
        .nav-links a { margin-left: 2rem; text-decoration: none; color: #333; font-weight: 500; transition: 0.3s; }
        .nav-links a:hover, .nav-links a.active { color: #667eea; }
        .hero { height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; color: white; padding: 0 2rem; }
        .hero-content h1 { font-size: 4rem; margin-bottom: 1rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.3); }
        .hero-content p { font-size: 1.4rem; margin-bottom: 2rem; opacity: 0.9; }
        .btn { padding: 15px 35px; border: none; border-radius: 50px; font-size: 1.1rem; font-weight: 600; 
               text-decoration: none; display: inline-block; transition: 0.3s; cursor: pointer; margin: 0 10px; }
        .btn-primary { background: linear-gradient(45deg, #ff6b6b, #feca57); color: white; box-shadow: 0 4px 15px rgba(255,107,107,0.4); }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(255,107,107,0.6); }
        .btn-secondary { background: rgba(255,255,255,0.2); color: white; border: 2px solid rgba(255,255,255,0.3); }
        .btn-secondary:hover { background: rgba(255,255,255,0.3); }
        @media (max-width: 768px) { .hero-content h1 { font-size: 2.5rem; } .nav-links a { margin-left: 1rem; font-size: 0.9rem; } }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo"><h2><i class="fas fa-store"></i> ResellerMart</h2></div>
            <div class="nav-links">
                <a href="#" class="active">Home</a>
                <a href="data:text/html;charset=utf-8," onclick="loadPage('products')">Products</a>
                <a href="data:text/html;charset=utf-8," onclick="loadPage('login')">Login</a>
                <a href="data:text/html;charset=utf-8," onclick="loadPage('register')">Register</a>
            </div>
        </div>
    </nav>

    <div class="hero">
        <div class="hero-content">
            <h1>🚀 Reseller बनो, कमाओ!</h1>
            <p>हमारे Platform से Products बेचो और अपने Resellers बनाओ</p>
            <div>
                <a href="data:text/html;charset=utf-8," onclick="loadPage('register')" class="btn btn-primary">Reseller बनें</a>
                <a href="data:text/html;charset=utf-8," onclick="loadPage('login')" class="btn btn-secondary">Login</a>
            </div>
        </div>
    </div>

    <script>
        function loadPage(page) {
            if(page === 'login') window.location.href = '#login';
            if(page === 'register') window.location.href = '#register';
            // यहाँ आप अलग files बना सकते हैं या single page app बना सकते हैं
            alert('Login/Register page खुल गया!');
        }
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</body>
</html>
